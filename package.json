{
  "name": "blizzard-in-the-forest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler dev",
    "release": "tsc --noEmit && vite build && wrangler deploy",
    "deploy": "vite build && wrangler deploy",
    "rollback": "wrangler rollback"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "wrangler": "^4.77.0"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "three": "^0.187.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
