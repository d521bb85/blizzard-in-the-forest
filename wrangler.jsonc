{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blizzard-in-the-forest",
  "compatibility_date": "2026-03-17",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "forest.ivanen.co",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
